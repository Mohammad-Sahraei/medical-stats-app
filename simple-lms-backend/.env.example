# Copy this file to .env and fill in real values. .env is loaded automatically
# on startup and should never be committed/shared.

# Gmail SMTP credentials used to send password-reset verification codes.
# MAIL_APP_PASSWORD is a 16-character Gmail "App Password" (Google Account ->
# Security -> 2-Step Verification -> App Passwords), NOT the normal Gmail
# login password.
MAIL_USERNAME=medicalstats.verify@gmail.com
MAIL_APP_PASSWORD=
